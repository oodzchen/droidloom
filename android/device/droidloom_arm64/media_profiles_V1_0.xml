            <Video codec="h264" bitRate="512000" width="176" height="144" frameRate="30" />
            <Audio codec="aac" bitRate="96000" sampleRate="48000" channels="1" />
        </EncoderProfile>
        <EncoderProfile quality="480p" fileFormat="mp4" duration="60">
            <Video codec="h264" bitRate="3000000" width="640" height="480" frameRate="30" />
            <Audio codec="aac" bitRate="128000" sampleRate="48000" channels="1" />
