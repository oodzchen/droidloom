[Unit]
Description=Droidloom Plasma Control Center D-Bus service
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.droidloom.ControlCenter
EnvironmentFile=-%h/.config/droidloom/panel.env
ExecStart=@PANEL_DAEMON_EXEC@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
